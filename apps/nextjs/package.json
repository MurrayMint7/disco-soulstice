{
  "name": "@disco/nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "lint": "eslint .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/server/db/seed.ts",
    "db:migrate-images": "tsx --env-file=.env src/server/db/migrate-images-to-blob.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.6",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.41.0",
    "next": "^15.2.3",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "stripe": "^20.4.1",
    "superjson": "^2.2.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@disco/eslint-config": "workspace:*",
    "@disco/tailwind-config": "workspace:*",
    "@disco/typescript-config": "workspace:*",
    "@disco/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.29.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
